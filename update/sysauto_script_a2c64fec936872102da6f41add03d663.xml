        <script><![CDATA[
// Get current time
var now = new GlideDateTime();

// Get time 24 hours from now
var next24Hours = new GlideDateTime();
next24Hours.addDays(1);

// Query NeedIt Task table for records due between now and next 24 hours
var upcomingTasks = new GlideRecord('x_58872_needit_needit_task');
upcomingTasks.addQuery('due_date', '>=', now);
upcomingTasks.addQuery('due_date', '<=', next24Hours);
upcomingTasks.addQuery('state', '!=', 3); // Exclude Closed Complete
upcomingTasks.query();

// Log each upcoming task
while (upcomingTasks.next()) {
    gs.info("Upcoming NeedIt Task due soon: " + upcomingTasks.number);
}
]]></script>
